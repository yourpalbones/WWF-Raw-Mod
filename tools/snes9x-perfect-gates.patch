+    unsigned realpc=pc; if(pc>=0x800000)pc&=0xbfffff;
+    if(pc!=0xacec56&&pc!=0xacec64&&pc!=0xacec72&&pc!=0xacec7c&&pc!=0xacec96&&pc!=0xacecb0&&pc!=0xacecb4&&pc!=0xaced08&&pc!=0x70f300&&pc!=0x80f073)return;
