+// WWF Raw research instrumentation: snapshots only; never writes game memory.
+#include <cstdio>
+#include <cstdlib>
+unsigned WWFFrame = 0;
+static unsigned WWFSource = 0, WWFDestination = 0, WWFReturn = 0, WWFLength = 0;
+static unsigned WWFDecodeNumber = 0;
+static unsigned WWFPointer(unsigned p) {
+    p = (Registers.D.W + p) & 0x1fff;
+    return Memory.RAM[p] | (Memory.RAM[p + 1] << 8) | (Memory.RAM[p + 2] << 16);
+}
+
+void WWFTraceWrite(uint32 Address) {
+    const char *dir = std::getenv("WWF_TRACE_DIR");
+    if (!dir) return;
+    static unsigned frame = ~0U, sites[128], count = 0;
+    if (WWFFrame != frame) {frame = WWFFrame; count = 0;}
+    unsigned site = (Registers.PBPC & 0xffffff) | ((Address & 0x800) << 14);
+    for (unsigned i = 0; i < count; ++i) if (sites[i] == site) return;
+    if (count >= 128) return;
+    sites[count++] = site;
+    char path[1024];
+    std::snprintf(path, sizeof(path), "%s/writes.jsonl", dir);
+    FILE *f = std::fopen(path, "a");
+    if (f) {
+        std::fprintf(f, "{\"frame\":%u,\"pc\":%u,\"address\":%u,\"a\":%u,\"x\":%u,\"y\":%u,\"db\":%u,\"d\":%u}\n", WWFFrame, Registers.PBPC & 0xffffff, Address, Registers.A.W, Registers.X.W, Registers.Y.W, Registers.DB, Registers.D.W);
+        std::fclose(f);
+    }
+    std::snprintf(path, sizeof(path), "%s/assets/dp-%06u-%06x-%06x.bin", dir, WWFFrame, Registers.PBPC & 0xffffff, Address & ~0x7ff);
+    f = std::fopen(path, "wb");
+    if (f) {std::fwrite(Memory.RAM + (Registers.D.W & 0x1fff), 1, 256, f);std::fclose(f);}
+}
+
+
+static unsigned WWFTileSource = 0, WWFTileDestination = 0, WWFTileReturn = 0, WWFTileNumber = 0, WWFTileID = 0;
+static unsigned WWFStackReturn() {
+    unsigned sp = Registers.S.W;
+    return (((Memory.RAM[(sp + 1) & 0x1fff] | (Memory.RAM[(sp + 2) & 0x1fff] << 8)) + 1) & 0xffff) | (Memory.RAM[(sp + 3) & 0x1fff] << 16);
+}
+static void WWFTraceTile(unsigned pc, const char *dir) {
+    if (pc == 0xacf959) WWFTileID = Registers.A.W;
+    if (WWFTileReturn && pc == WWFTileReturn) {
+        char path[1024];
+        std::snprintf(path, sizeof(path), "%s/assets/tile-%06u-%06x.bin", dir, WWFTileNumber, WWFTileSource);
+        FILE *f = std::fopen(path, "wb");
+        if (f) {std::fwrite(Memory.RAM + WWFTileDestination, 1, 32, f);std::fclose(f);}
+        std::snprintf(path, sizeof(path), "%s/tiles.jsonl", dir);
+        f = std::fopen(path, "a");
+        if (f) {
+            std::fprintf(f, "{\"event\":%u,\"frame\":%u,\"source\":%u,\"destination\":%u,\"tile_id\":%u}\n", WWFTileNumber, WWFFrame, WWFTileSource, 0x7e0000 + WWFTileDestination, WWFTileID);
+            std::fclose(f);
+        }
+        WWFTileReturn = 0;
+    }
+    if (pc == 0xacf775) {
+        WWFTileSource = WWFPointer(0xdb);
+        WWFTileDestination = Registers.Y.W;
+        WWFTileReturn = WWFStackReturn();
+        ++WWFTileNumber;
+    }
+}
+
+static void WWFTraceCPU() {
+    const char *dir = std::getenv("WWF_TRACE_DIR");
+    if (!dir) return;
+    unsigned pc = Registers.PBPC & 0xffffff;
+    WWFTraceTile(pc, dir);
+    if (WWFReturn && pc == WWFReturn) {
+        if ((WWFDestination >> 16) == 0x7e || (WWFDestination >> 16) == 0x7f) {
+            char path[1024];
+            std::snprintf(path, sizeof(path), "%s/assets/decoded-%06u-%06x.bin", dir, WWFDecodeNumber, WWFSource);
+            FILE *f = std::fopen(path, "wb");
+            unsigned dest = WWFDestination - 0x7e0000;
+            if (f) {
+                if (dest + WWFLength <= 0x20000) std::fwrite(Memory.RAM + dest, 1, WWFLength, f);
+                std::fclose(f);
+            }
+            std::snprintf(path, sizeof(path), "%s/decodes.jsonl", dir);
+            f = std::fopen(path, "a");
+            if (f) {
+                std::fprintf(f, "{\"event\":%u,\"frame\":%u,\"source\":%u,\"destination\":%u,\"length\":%u,\"partial\":%u}\n", WWFDecodeNumber, WWFFrame, WWFSource, WWFDestination, WWFLength, unsigned(CheckCarry()));
+                std::fclose(f);
+            }
+        }
+        WWFReturn = 0;
+    }
+    if (pc == 0xabf5ae) {
+        WWFSource = WWFPointer(0x7c);
+        WWFDestination = WWFPointer(0x80);
+        unsigned off = WWFSource & 0x3fffff;
+        WWFLength = Memory.ROM[off] | (Memory.ROM[off + 1] << 8);
+        unsigned sp = Registers.S.W;
+        WWFReturn = (((Memory.RAM[(sp + 1) & 0x1fff] | (Memory.RAM[(sp + 2) & 0x1fff] << 8)) + 1) & 0xffff) | (Memory.RAM[(sp + 3) & 0x1fff] << 16);
+        ++WWFDecodeNumber;
+    }
+}
